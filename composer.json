{
    "name": "itechsection/salesprosdk",
    "description": "Enterprise-grade PHP SDK for the SalesPro / SectionERP API — with full CodeIgniter 3 & 4 integration",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "salespro",
        "itechsection",
        "erp",
        "pos",
        "sdk",
        "api",
        "codeigniter",
        "codeigniter4"
    ],
    "authors": [
        {
            "name": "Section Technology",
            "email": "contact@itechsection.com",
            "homepage": "https://itechsection.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0",
        "mockery/mockery": "^1.5",
        "php-mock/php-mock-phpunit": "^2.6",
        "guzzlehttp/promises": "^1.5 || ^2.0",
        "symfony/cache": "^5.0 || ^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "ITechSection\\SalesPro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ITechSection\\SalesPro\\Tests\\": "tests/"
        }
    },
    "extra": {
        "codeigniter4": {
            "Config": "src/Config"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --coverage-html=coverage",
        "cs-fix": "php-cs-fixer fix src tests",
        "analyze": "phpstan analyse src --level=8"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}