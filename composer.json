{
    "name": "salespro/salespro-php-sdk",
    "description": "Complete PHP SDK for SalesPro POS REST API with support for Laravel 10+ and CodeIgniter 4",
    "type": "library",
    "keywords": [
        "salespro",
        "pos",
        "api",
        "sdk",
        "php",
        "rest",
        "laravel",
        "codeigniter",
        "e-commerce",
        "point-of-sale"
    ],
    "homepage": "https://github.com/salespro/php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "SalesPro Team",
            "email": "sdk@salespro.dev",
            "role": "Developer",
            "homepage": "https://salespro.dev/team"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "psr/log": "^3.0|^1.0|^2.0",
        "guzzlehttp/guzzle": "^7.8|^7.5|^6.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^10.0|^9.6",
        "squizlabs/php_codesniffer": "^3.0",
        "php-parallel-lint/php-parallel-lint": "^1.3|^1.2",
        "friendsofphp/php-cs-fixer": "^3.13|^3.12"
    },
    "autoload": {
        "psr-4": {
            "SalesPro\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SalesPro\\SDK\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "laminas/laminas-hydrator": "^4.9|^4.8",
        "monolog/monolog": "^3.5|^3.4|^2.9"
    },
    "provide": {
        
    },
    "support": {
        "issues": "https://github.com/salespro/php-sdk/issues",
        "forum": "https://github.com/salespro/php-sdk/discussions",
        "source": "https://github.com/salespro/php-sdk",
        "docs": "https://docs.salespro.api/sdk/php"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "dev-develop"
        },
        "laravel": {
            "providers": [
                "SalesPro\\SDK\\Laravel\\SalesProServiceProvider"
            ],
            "aliases": {
                "SalesPro": "SalesPro\\SDK\\Facades\\SalesPro"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html coverage/",
        "analyze": "vendor/bin/phpstan analyse",
        "fix-style": "vendor/bin/php-cs-fixer fix",
        "check-style": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "post-install-cmd": [
            "SalesPro\\SDK\\Composer\\ScriptHandler::postInstall"
        ],
        "post-update-cmd": [
            "SalesPro\\SDK\\Composer\\ScriptHandler::postUpdate"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "php-http/async": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": ["/tests", "/.*", "composer.json"]
    }
}